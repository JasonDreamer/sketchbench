{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@sketchbench/runtime": ["./types/sketchbench-runtime.d.ts"],
      "p5": ["./types/p5/p5.d.ts"]
    }
  },
  "include": ["works/**/*.ts", "templates/**/*.ts"]
}
