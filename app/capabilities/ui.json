{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "UI WebView。アプリのコマンドとイベントを使う",
  "webviews": ["ui"],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-open-work",
    "allow-create-work",
    "allow-play",
    "allow-seek",
    "allow-set-preview-rect",
    "allow-set-preview-hidden",
    "allow-reload-preview",
    "allow-start-export",
    "allow-queue-add",
    "allow-queue-list",
    "allow-queue-cancel",
    "allow-queue-clear",
    "allow-measure-loudness",
    "allow-render-stills",
    "allow-relink-pick",
    "allow-lsp-start",
    "allow-lsp-send",
    "allow-code-files",
    "allow-code-read",
    "allow-code-write",
    "allow-edit-project",
    "allow-undo",
    "allow-redo",
    "allow-midi-connect",
    "allow-midi-record",
    "allow-preview-still",
    "allow-set-ui-context",
    "allow-list-history",
    "allow-restore-history",
    "allow-reveal"
  ]
}
