{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "UI WebView。アプリのコマンドとイベントを使う",
  "webviews": ["ui"],
  "permissions": [
    "core:event:default",
    "allow-get-state",
    "allow-open-work",
    "allow-create-work",
    "allow-play",
    "allow-seek",
    "allow-set-preview-rect",
    "allow-set-preview-hidden",
    "allow-reload-preview",
    "allow-start-export",
    "allow-reveal"
  ]
}
